{
  "name": "ai-exploratory-tester",
  "private": true,
  "description": "Exploratory testing agent (Claude + Playwright MCP), measured against a shop app with planted bugs",
  "license": "MIT",
  "scripts": {
    "start": "node app/server.js",
    "test:unit": "node --test app/flags.test.js qa-report/*.test.mts score/*.test.mts",
    "test": "playwright test",
    "typecheck": "tsc -p .",
    "verify:bugs": "node scripts/verify-bugs.mjs",
    "agent": "node agent/run.mts",
    "score": "node score/score.mts",
    "agreement": "node score/agreement.mts",
    "results": "node score/results.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/mcp": "0.0.86",
    "zod": "4.6.7"
  }
}
